PORT=5000
# Include the database segment (…/<database>). If omitted, Mongoose defaults to DB `test` — open **`test`** in Compass.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://your-app-name.onrender.com
FRONTEND_URL=https://your-app-name.onrender.com

# Optional override for default admin (server.js seeds admin@healthsys.com / Admin@123 if missing).
ADMIN_EMAIL=admin@healthsys.com
ADMIN_PASSWORD=Admin@123

# Optional email settings for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_NAME=HealthSys
